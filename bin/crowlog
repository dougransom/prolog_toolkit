#!/usr/bin/env bash
set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Path to the crowlog top-level Prolog file
TOPLEVEL_PL="$ROOT_DIR/crowlog/crowlog_toplevel.pl"

# Execute scryer-safe with -f (no rc file) and -t (toplevel) flags, passing any user arguments.
exec scryer-safe -f -t crowlog_toplevel "$TOPLEVEL_PL" "$@"
